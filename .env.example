# Copy this to .env and fill in your real values
OLLAMA_CLOUD_BASE_URL=https://your-ollama-endpoint.com
OLLAMA_CLOUD_API_KEY=your-api-key-here

VITE_OLLAMA_MODEL=glm-5.2

# System SMTP — used to send transactional auth emails (forgot password).
# Example for Gmail: host smtp.gmail.com, port 587, secure false, and an
# App Password (not your normal Gmail password) for SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Pitch Studio <you@gmail.com>
