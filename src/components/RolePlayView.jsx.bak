import React, { useState, useEffect, useRef } from "react";
import { callModel, nameOf } from "../utils/helpers.js";
import { METHODS, CALL_TYPES, LANGUAGES } from "../data/constants.js";
import { RowSkeleton } from "./shared/Skeletons.jsx";

/* ============================================================
   AI Role-play Scenarios (P5.5)
   Multi-turn AI buyer simulation with persona-based responses
   and conversation-level scoring.
   ============================================================ */

export default function RolePlayView({ products }) {
  const [step, setStep] = useState("setup"); // setup | active | ended
  const [selectedProduct, setSelectedProduct] = useState(null);
  const [selectedPersona, setSelectedPersona] = useState("");
  const [method, setMethod] = useState("consultative");
  const [callType, setCallType] = useState("discovery");
  const [messages, setMessages] = useState([]);
  const [input, setInput] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const [turnCount, setTurnCount] = useState(0);
  const [finalScore, setFinalScore] = useState(null);
  const [suggestions, setSuggestions] = useState([]);
  const bottomRef = useRef(null);
  const [isListening, setIsListening] = useState(false);

  const personas = (selectedProduct?.personas || "").split(/[\n,]/).map((s) => s.trim()).filter(Boolean);

  useEffect(() => {
    bottomRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages]);

  const startRolePlay = async () => {
    if (!selectedProduct) return;
    setStep("active");
    setMessages([]);
    setTurnCount(0);
    setFinalScore(null);
    setError("");
    setSuggestions([]);

    // AI opens as the buyer
    setLoading(true);
    try {
      const SYS = `You are a realistic buyer in a B2B sales call. You are ${selectedPersona || "a typical prospect"}. You are skeptical but willing to listen. Respond in character. Keep responses to 1-3 sentences.`;
      const prompt = `Product: ${selectedProduct.name}. Description: ${selectedProduct.description || ""}. Method: ${method}. Call type: ${callType}. Persona: ${selectedPersona || "General audience"}.

You are the buyer. Start the conversation. Either ask a challenging question, express a concern, or ask for more information. Be specific to the product.`;
      const ai = await callModel(SYS, prompt);
      const text = (ai.message?.content || ai.content || "").trim().slice(0, 500);
      setMessages([{ role: "buyer", text, timestamp: Date.now() }]);
      setTurnCount(1);
    } catch (e) {
      setError("Failed to start role-play: " + (e.message || "try again"));
      setStep("setup");
    } finally {
      setLoading(false);
    }
  };

  const sendMessage = async (text) => {
    if (!text.trim() || loading) return;
    const userText = text.trim();
    setMessages((prev) => [...prev, { role: "rep", text: userText, timestamp: Date.now() }]);
    setInput("");
    setLoading(true);
    setSuggestions([]);

    try {
      const conversation = messages.map((m) => `${m.role === "buyer" ? "Buyer" : "Rep"}: ${m.text}`).join("\n");
      const SYS = `You are a realistic buyer in a B2B sales call. You are ${selectedPersona || "a typical prospect"}. Respond naturally to what the sales rep just said. Keep it to 1-3 sentences. Be skeptical but not rude.`;
      const prompt = `Product: ${selectedProduct.name}. Description: ${selectedProduct.description || ""}. Method: ${method}. Call type: ${callType}. Persona: ${selectedPersona || "General audience"}.

Conversation so far:
${conversation}
Rep: ${userText}

You are the buyer. Respond naturally.`;
      const ai = await callModel(SYS, prompt);
      const reply = (ai.message?.content || ai.content || "").trim().slice(0, 500);
      setMessages((prev) => [...prev, { role: "buyer", text: reply, timestamp: Date.now() }]);
      setTurnCount((t) => t + 1);

      // Generate suggestions after buyer responds
      const suggestSYS = `You are a sales coach. Given the conversation, suggest 2 short, natural ways the rep could respond next. Each suggestion should be 1 sentence. Return ONLY a JSON array of strings.`;
      const suggestPrompt = `Product: ${selectedProduct.name}. Persona: ${selectedPersona || "General audience"}.

Conversation:
${conversation}
Rep: ${userText}
Buyer: ${reply}

Suggest 2 natural next responses for the rep. Return ["suggestion 1", "suggestion 2"]`;
      try {
        const suggestAi = await callModel(suggestSYS, suggestPrompt);
        const suggestText = suggestAi.message?.content || suggestAi.content || "";
        const clean = suggestText.replace(/```json/gi, "").replace(/```/g, "").trim();
        const jsonStart = clean.indexOf("[");
        const parsed = JSON.parse(clean.slice(jsonStart >= 0 ? jsonStart : 0));
        if (Array.isArray(parsed)) setSuggestions(parsed.slice(0, 2));
      } catch (_) {
        setSuggestions([]);
      }
    } catch (e) {
      setError("AI response failed: " + (e.message || "try again"));
    } finally {
      setLoading(false);
    }
  };

  const endRolePlay = async () => {
    setLoading(true);
    try {
      const conversation = messages.map((m) => `${m.role === "buyer" ? "Buyer" : "Rep"}: ${m.text}`).join("\n");
      const SYS = `You are an elite sales coach evaluating a rep's performance across a full conversation. Score on four dimensions (0-100):
- rapport: Did they build trust and connection?
- objection_handling: Did they handle pushback well?
- closing: Did they move the deal forward?
- discovery: Did they uncover needs?
Return ONLY JSON:
{"rapport":0-100,"objection_handling":0-100,"closing":0-100,"discovery":0-100,"feedback":"2-3 sentences of overall feedback","strength":"what they did best","improvement":"one priority to work on"}`;
      const prompt = `Product: ${selectedProduct.name}. Method: ${method}. Call type: ${callType}. Persona: ${selectedPersona || "General audience"}.

Full conversation:
${conversation}

Evaluate the rep's performance.`;
      const ai = await callModel(SYS, prompt);
      const text = ai.message?.content || ai.content || "";
      let parsed = {};
      try {
        const clean = text.replace(/```json/gi, "").replace(/```/g, "").trim();
        const jsonStart = clean.indexOf("{");
        parsed = JSON.parse(clean.slice(jsonStart >= 0 ? jsonStart : 0));
      } catch (_) {
        parsed = { rapport: 0, objection_handling: 0, closing: 0, discovery: 0, feedback: text.slice(0, 400), strength: "", improvement: "" };
      }
      setFinalScore({
        rapport: Math.min(100, Math.max(0, parsed.rapport || 0)),
        objection_handling: Math.min(100, Math.max(0, parsed.objection_handling || 0)),
        closing: Math.min(100, Math.max(0, parsed.closing || 0)),
        discovery: Math.min(100, Math.max(0, parsed.discovery || 0)),
        feedback: parsed.feedback || "",
        strength: parsed.strength || "",
        improvement: parsed.improvement || "",
      });
      setStep("ended");
    } catch (e) {
      setError("Evaluation failed: " + (e.message || "try again"));
    } finally {
      setLoading(false);
    }
  };

  const startListening = () => {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRecognition) { alert("Speech recognition not supported. Try Chrome."); return; }
    const rec = new SpeechRecognition();
    rec.continuous = false;
    rec.interimResults = true;
    rec.lang = "en-US";
    rec.onresult = (e) => {
      const transcript = Array.from(e.results).map((r) => r[0].transcript).join(" ");
      setInput(transcript);
    };
    rec.onerror = () => setIsListening(false);
    rec.onend = () => setIsListening(false);
    rec.start();
    setIsListening(true);
  };

  const avg = (scores) => Math.round((scores.rapport + scores.objection_handling + scores.closing + scores.discovery) / 4);
  const scoreColor = (s) => s >= 80 ? "var(--ok)" : s >= 60 ? "var(--amber)" : "var(--aggressive)";

  return (
    <div>
      <div className="ps-top">
        <div>
          <div className="ps-eyebrow">P5.5</div>
          <div className="ps-title">AI Role-play</div>
          <div className="ps-sub">Have a back-and-forth conversation with an AI buyer. Get scored on rapport, objection handling, closing, and discovery.</div>
        </div>
      </div>

      <div className="ps-body">
        {step === "setup" && (
          <>
            <div className="ps-form" style={{ maxWidth: 560 }}>
              <div className="frow">
                <label className="flab">Product</label>
                <select className="fsel" value={selectedProduct?.id || ""} onChange={(e) => {
                  const p = products.find((x) => x.id === e.target.value);
                  setSelectedProduct(p || null);
                  setSelectedPersona("");
                }}>
                  <option value="">Select a product…</option>
                  {products.map((p) => <option key={p.id} value={p.id}>{p.name}</option>)}
                </select>
              </div>

              {personas.length > 0 && (
                <div className="frow">
                  <label className="flab">Buyer Persona</label>
                  <select className="fsel" value={selectedPersona} onChange={(e) => setSelectedPersona(e.target.value)}>
                    <option value="">General audience</option>
                    {personas.map((p) => <option key={p} value={p}>{p}</option>)}
                  </select>
                  <div className="fhint">The AI buyer will adopt this persona's attitude and concerns.</div>
                </div>
              )}

              <div className="frow two">
                <div>
                  <label className="flab">Method</label>
                  <select className="fsel" value={method} onChange={(e) => setMethod(e.target.value)}>
                    {METHODS.map((m) => <option key={m.id} value={m.id}>{m.name}</option>)}
                  </select>
                </div>
                <div>
                  <label className="flab">Call type</label>
                  <select className="fsel" value={callType} onChange={(e) => setCallType(e.target.value)}>
                    {CALL_TYPES.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}
                  </select>
                </div>
              </div>

              <button className="ps-btn pri" disabled={!selectedProduct || loading} onClick={startRolePlay}>
                {loading ? <><span className="spinner" /> Starting…</> : "🎭 Start Role-play"}
              </button>
            </div>
          </>
        )}

        {(step === "active" || step === "ended") && (
          <div style={{ maxWidth: 720 }}>
            <div style={{ display: "flex", alignItems: "center", gap: 10, marginBottom: 18 }}>
              <button className="ps-btn ghost sm" onClick={() => setStep("setup")}>← New session</button>
              <span className="chip n">{selectedProduct?.name}</span>
              {selectedPersona && <span className="chip">👤 {selectedPersona}</span>}
              <span className="chip">{nameOf(METHODS, method)} · {nameOf(CALL_TYPES, callType)}</span>
              <div className="rp-turns" style={{ marginLeft: "auto" }}>{turnCount} turn{turnCount !== 1 ? "s" : ""}</div>
            </div>

            {step === "active" && (
              <>
                <div className="rp-chat">
                  {messages.map((m, i) => (
                    <div key={i} className={`rp-bubble ${m.role}`}>
                      <div className={`rp-avatar ${m.role}`}>{m.role === "buyer" ? "🧑" : "🎤"}</div>
                      <div>
                        <div className={`rp-msg ${m.role}`}>{m.text}</div>
                        <div className="rp-meta">{m.role === "buyer" ? "AI Buyer" : "You"} · {new Date(m.timestamp).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}</div>
                      </div>
                    </div>
                  ))}
                  {loading && (
                    <div className="rp-bubble buyer">
                      <div className="rp-avatar buyer">🧑</div>
                      <div className="rp-msg buyer" style={{ display: "flex", alignItems: "center", gap: 8 }}>
                        <span className="spinner dark" style={{ width: 14, height: 14 }} />
                        <span style={{ fontSize: 13, color: "var(--faint)" }}>Buyer is thinking…</span>
                      </div>
                    </div>
                  )}
                  <div ref={bottomRef} />
                </div>

                {/* Suggestions */}
                {suggestions.length > 0 && !loading && (
                  <div style={{ marginTop: 10 }}>
                    <div className="fhint" style={{ marginBottom: 6 }}>💡 Stuck? Try one of these:</div>
                    {suggestions.map((s, i) => (
                      <div key={i} className="rp-suggestion" onClick={() => sendMessage(s)}>
                        {s}
                      </div>
                    ))}
                  </div>
                )}

                <div className="rp-input-wrap">
                  <textarea
                    className="rp-input"
                    placeholder="Type your response…"
                    value={input}
                    onChange={(e) => setInput(e.target.value)}
                    onKeyDown={(e) => { if (e.key === "Enter" && e.metaKey) sendMessage(input); }}
                  />
                  <div style={{ display: "flex", flexDirection: "column", gap: 6 }}>
                    <button className="rp-send" disabled={!input.trim() || loading} onClick={() => sendMessage(input)}>Send</button>
                    <button className="ps-btn ghost sm" onClick={isListening ? () => setIsListening(false) : startListening}>
                      {isListening ? "⏹" : "🎤"}
                    </button>
                  </div>
                </div>
                <div className="fhint">Cmd/Ctrl + Enter to send · Minimum 3 turns recommended before ending.</div>

                <div style={{ display: "flex", gap: 10, marginTop: 14 }}>
                  <button className="ps-btn pri" disabled={turnCount < 2 || loading} onClick={endRolePlay}>
                    {loading ? "Evaluating…" : "✓ End & Score"}
                  </button>
                </div>
              </>
            )}

            {step === "ended" && finalScore && (
              <div className="rp-end">
                <div className="rp-end-h">📊 Conversation Score</div>
                <div className="practice-scores" style={{ marginBottom: 18 }}>
                  {[
                    { label: "Rapport", value: finalScore.rapport },
                    { label: "Objection Handling", value: finalScore.objection_handling },
                    { label: "Closing", value: finalScore.closing },
                    { label: "Discovery", value: finalScore.discovery },
                  ].map((s) => (
                    <div key={s.label} className="practice-score">
                      <div className="ps-label">{s.label}</div>
                      <div className="ps-bar-wrap">
                        <div className="ps-bar" style={{ width: `${s.value}%`, background: scoreColor(s.value) }} />
                      </div>
                      <div className="ps-val" style={{ color: scoreColor(s.value) }}>{s.value}</div>
                    </div>
                  ))}
                  <div className="practice-total">
                    <div className="ps-label">Overall</div>
                    <div className="ps-total-val" style={{ color: scoreColor(avg(finalScore)) }}>{avg(finalScore)}</div>
                  </div>
                </div>

                {finalScore.strength && (
                  <div style={{ background: "#EDF9F2", border: "1px solid #B9E1CA", borderRadius: 10, padding: 14, marginBottom: 12, fontSize: 13.5, lineHeight: 1.55 }}>
                    <b style={{ color: "#1A7F5B" }}>✓ Strength:</b> {finalScore.strength}
                  </div>
                )}
                {finalScore.improvement && (
                  <div style={{ background: "#FBF1DE", border: "1px solid #F0D9A6", borderRadius: 10, padding: 14, marginBottom: 12, fontSize: 13.5, lineHeight: 1.55 }}>
                    <b style={{ color: "#9A5B08" }}>↗ Priority:</b> {finalScore.improvement}
                  </div>
                )}
                {finalScore.feedback && (
                  <div style={{ background: "#F2F5FA", borderRadius: 10, padding: 14, fontSize: 13.5, lineHeight: 1.55, color: "var(--muted)" }}>
                    <b style={{ color: "var(--ink)" }}>Feedback:</b> {finalScore.feedback}
                  </div>
                )}

                <div style={{ display: "flex", gap: 10, marginTop: 20 }}>
                  <button className="ps-btn pri" onClick={() => { setStep("active"); setMessages([]); setTurnCount(0); setFinalScore(null); startRolePlay(); }}>🎭 New Role-play</button>
                  <button className="ps-btn ghost" onClick={() => setStep("setup")}>Change setup</button>
                </div>
              </div>
            )}

            {error && <div className="err" style={{ marginTop: 12 }}>{error}</div>}
          </div>
        )}
      </div>
    </div>
  );
}
